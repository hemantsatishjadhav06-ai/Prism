# Copy to .env.local for development. Never commit real values.

# ── Indexing gate (spec §10.3) ──────────────────────────────────────
# Indexing is allowed ONLY when this is exactly the string 'true'.
# Missing, empty, misspelled, 'TRUE' or '1' all mean noindex.
#
# This default is deliberate. The staging deployment is a public copy of a
# site that already ranks, and Vercel's automatic noindex covers non-production
# preview deployments but NOT the production *.vercel.app alias — which is
# exactly the URL that gets shared with a client.
#
# Set to 'true' once, scoped to Production, after the real domain resolves and
# has been verified end to end.
#
# Note: setting this to 'true' also puts the content gate into STRICT mode,
# so a deployment cannot be crawlable and have unresolved TODO markers.
NEXT_PUBLIC_INDEXABLE=

# ── Contact form delivery (spec §9, §13.4) ──────────────────────────
# All three are required for the form to send. With any of them absent the
# route returns 503 and the UI surfaces the direct email address, so a lead
# is never silently lost.
RESEND_API_KEY=
CONTACT_DESTINATION_EMAIL=
CONTACT_FROM_EMAIL=

# ── Spam protection (spec §9) ───────────────────────────────────────
# Absent secret ⇒ Turnstile verification is skipped, so the form works end to
# end in development. The honeypot and the 3-second minimum time-to-submit
# check are always active.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ── Content gate (spec §13.3) ───────────────────────────────────────
# Set to 'strict' to force a hard failure on unresolved TODO markers locally.
# Already implied by NEXT_PUBLIC_INDEXABLE=true or VERCEL_ENV=production.
CONTENT_GATE=
